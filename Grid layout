<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Lakshmidhar | Advanced Portfolio</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

:root{

    --bg-color:#020617;
    --secondary-bg:#0f172a;
    --card-bg:rgba(255,255,255,0.06);

    --text-color:#ffffff;
    --secondary-text:#cbd5e1;

    --primary-color:#38bdf8;
    --gradient:linear-gradient(90deg,#38bdf8,#8b5cf6);

    --shadow:0 10px 25px rgba(0,0,0,0.3);

}

.light-mode{

    --bg-color:#f8fafc;
    --secondary-bg:#ffffff;
    --card-bg:#ffffff;

    --text-color:#0f172a;
    --secondary-text:#334155;

    --primary-color:#2563eb;

    --shadow:0 10px 25px rgba(0,0,0,0.1);

}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
    scroll-behavior:smooth;
}

body{
    background:var(--bg-color);
    color:var(--text-color);
    transition:0.4s;
}

header{
    position:fixed;
    width:100%;
    top:0;
    left:0;
    z-index:1000;
    backdrop-filter:blur(12px);
    background:rgba(255,255,255,0.05);
    border-bottom:1px solid rgba(255,255,255,0.1);
}

.navbar{
    width:90%;
    max-width:1200px;
    margin:auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px 0;
}

.logo{
    font-size:30px;
    font-weight:700;
    color:var(--primary-color);
}

nav ul{
    display:flex;
    list-style:none;
    gap:30px;
}

nav a{
    text-decoration:none;
    color:var(--text-color);
    transition:0.3s;
    font-weight:500;
}

nav a:hover{
    color:var(--primary-color);
}

.theme-btn{
    padding:10px 18px;
    border:none;
    border-radius:40px;
    background:var(--gradient);
    color:white;
    cursor:pointer;
    font-weight:600;
}

.hero{
    min-height:100vh;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    align-items:center;
    gap:40px;
    width:90%;
    max-width:1200px;
    margin:auto;
    padding-top:120px;
}

.hero-text h1{
    font-size:70px;
    line-height:1.2;
    margin-bottom:20px;
}

.hero-text span{
    background:var(--gradient);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
}

.hero-text p{
    color:var(--secondary-text);
    margin-bottom:30px;
    font-size:18px;
}

.btn{
    display:inline-block;
    padding:15px 35px;
    background:var(--gradient);
    color:white;
    text-decoration:none;
    border-radius:50px;
    font-weight:600;
    transition:0.4s;
}

.btn:hover{
    transform:translateY(-5px);
    box-shadow:var(--shadow);
}

.hero-image{
    display:flex;
    justify-content:center;
}

.hero-image img{
    width:100%;
    max-width:420px;
    border-radius:30px;
    box-shadow:var(--shadow);
}

section{
    padding:100px 5%;
}

.section-title{
    text-align:center;
    margin-bottom:60px;
}

.section-title h2{
    font-size:50px;
    margin-bottom:15px;
}

.section-title p{
    color:var(--secondary-text);
}

.about-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:30px;
}

.card{
    background:var(--card-bg);
    backdrop-filter:blur(12px);
    padding:35px;
    border-radius:25px;
    transition:0.4s;
    box-shadow:var(--shadow);
}

.card:hover{
    transform:translateY(-10px);
}

.card h3{
    color:var(--primary-color);
    margin-bottom:15px;
}

.projects-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
    gap:35px;
}

.project-card{
    background:var(--card-bg);
    border-radius:25px;
    overflow:hidden;
    transition:0.4s;
    box-shadow:var(--shadow);
}

.project-card:hover{
    transform:translateY(-10px);
}

.project-card img{
    width:100%;
    height:250px;
    object-fit:cover;
}

.project-content{
    padding:25px;
}

.project-content h3{
    margin-bottom:15px;
}

.project-content p{
    color:var(--secondary-text);
    margin-bottom:20px;
}

.skills-container{
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:20px;
}

.skill{
    background:var(--card-bg);
    padding:18px 30px;
    border-radius:50px;
    box-shadow:var(--shadow);
    transition:0.3s;
}

.skill:hover{
    background:var(--primary-color);
    color:white;
}

.contact-container{
    display:flex;
    justify-content:center;
}

.contact-form{
    width:100%;
    max-width:700px;
    background:var(--card-bg);
    padding:40px;
    border-radius:25px;
    box-shadow:var(--shadow);
}

.contact-form input,
.contact-form textarea{
    width:100%;
    padding:18px;
    margin-bottom:20px;
    border:none;
    border-radius:15px;
    background:rgba(255,255,255,0.08);
    color:var(--text-color);
    outline:none;
}

.contact-form textarea{
    resize:none;
}

footer{
    text-align:center;
    padding:30px;
    color:var(--secondary-text);
}

@media(max-width:992px){

    .hero-text h1{
        font-size:55px;
    }

}

@media(max-width:768px){

    .navbar{
        flex-direction:column;
        gap:20px;
    }

    nav ul{
        flex-wrap:wrap;
        justify-content:center;
        gap:15px;
    }

    .hero{
        text-align:center;
    }

    .hero-text h1{
        font-size:42px;
    }

    .section-title h2{
        font-size:38px;
    }

}

@media(max-width:480px){

    .hero-text h1{
        font-size:34px;
    }

    .btn{
        width:100%;
        text-align:center;
    }

    .theme-btn{
        width:100%;
    }

}

</style>

</head>

<body>

<header>

    <div class="navbar">

        <div class="logo">
            Lakshmidhar
        </div>

        <nav>

            <ul>

                <li><a href="#home">Home</a></li>

                <li><a href="#about">About</a></li>

                <li><a href="#projects">Projects</a></li>

                <li><a href="#skills">Skills</a></li>

                <li><a href="#contact">Contact</a></li>

            </ul>

        </nav>

        <button class="theme-btn" id="themeToggle">
            Toggle Theme
        </button>

    </div>

</header>

<section class="hero" id="home">

    <div class="hero-text">

        <h1>
            Hi, I'm <span>Lakshmidhar</span>
        </h1>

        <p>
            Frontend Developer passionate about creating
            visually stunning and highly responsive websites
            using modern CSS3 architectures.
        </p>

        <a href="#projects" class="btn">
            View Projects
        </a>

    </div>

    <div class="hero-image">

        <img
            src="https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?q=80&w=1200&auto=format&fit=crop"
            alt="Developer"
        >

    </div>

</section>

<section id="about">

    <div class="section-title">

        <h2>
            About Me
        </h2>

        <p>
            Modern web developer focused on responsive architecture
        </p>

    </div>

    <div class="about-grid">

        <div class="card">

            <h3>
                Responsive Design
            </h3>

            <p>
                Mobile-first layouts optimized for every screen size.
            </p>

        </div>

        <div class="card">

            <h3>
                Advanced CSS3
            </h3>

            <p>
                CSS Grid, Flexbox, animations and glassmorphism UI design.
            </p>

        </div>

        <div class="card">

            <h3>
                Accessibility
            </h3>

            <p>
                WCAG-friendly semantic HTML5 and accessible interfaces.
            </p>

        </div>

    </div>

</section>

<section id="projects">

    <div class="section-title">

        <h2>
            Featured Projects
        </h2>

        <p>
            Professional frontend applications and responsive websites
        </p>

    </div>

    <div class="projects-grid">

        <div class="project-card">

            <img
                src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=1200&auto=format&fit=crop"
                alt="Portfolio"
            >

            <div class="project-content">

                <h3>
                    Portfolio Website
                </h3>

                <p>
                    Fully responsive personal portfolio with modern UI.
                </p>

                <a href="#" class="btn">
                    View Project
                </a>

            </div>

        </div>

        <div class="project-card">

            <img
                src="https://images.unsplash.com/photo-1556740749-887f6717d7e4?q=80&w=1200&auto=format&fit=crop"
                alt="Ecommerce"
            >

            <div class="project-content">

                <h3>
                    E-Commerce Store
                </h3>

                <p>
                    Modern online shopping UI with API integration.
                </p>

                <a href="#" class="btn">
                    View Project
                </a>

            </div>

        </div>

        <div class="project-card">

            <img
                src="https://images.unsplash.com/photo-1484480974693-6ca0a78fb36b?q=80&w=1200&auto=format&fit=crop"
                alt="Task App"
            >

            <div class="project-content">

                <h3>
                    TaskFlow App
                </h3>

                <p>
                    Productivity application with interactive task management.
                </p>

                <a href="#" class="btn">
                    View Project
                </a>

            </div>

        </div>

    </div>

</section>

<section id="skills">

    <div class="section-title">

        <h2>
            Skills
        </h2>

        <p>
            Modern technologies and frontend expertise
        </p>

    </div>

    <div class="skills-container">

        <div class="skill">HTML5</div>

        <div class="skill">CSS3</div>

        <div class="skill">JavaScript</div>

        <div class="skill">React</div>

        <div class="skill">Responsive Design</div>

        <div class="skill">CSS Grid</div>

        <div class="skill">Flexbox</div>

        <div class="skill">UI/UX</div>

    </div>

</section>

<section id="contact">

    <div class="section-title">

        <h2>
            Contact Me
        </h2>

        <p>
            Let's create beautiful web experiences together
        </p>

    </div>

    <div class="contact-container">

        <form class="contact-form">

            <input
                type="text"
                placeholder="Enter Your Name"
                required
            >

            <input
                type="email"
                placeholder="Enter Your Email"
                required
            >

            <textarea
                rows="6"
                placeholder="Enter Your Message"
                required
            ></textarea>

            <button class="btn" type="submit">
                Send Message
            </button>

        </form>

    </div>

</section>

<footer>

    <p>
        © 2026 Lakshmidhar. All Rights Reserved.
    </p>

</footer>

<script>

const themeToggle =
document.getElementById("themeToggle");

themeToggle.addEventListener("click", () => {

    document.body.classList.toggle("light-mode");

});

</script>

</body>

</html>
